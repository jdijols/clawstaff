{
  "agents": {
    "defaults": {
      "workspace": "~/projects",
      "model": {
        "primary": "openrouter/anthropic/claude-sonnet-4-5"
      }
    },
    "list": [
      {
        "id": "ux-designer",
        "default": true,
        "identity": {
          "name": "UX Designer",
          "emoji": "🎨",
          "theme": "expert UX designer — wireframes, prototypes, and design systems"
        }
      }
    ]
  },
  "env": {
    "OPENROUTER_API_KEY": "your-openrouter-api-key"
  },
  "channels": {
    "whatsapp": {
      "dmPolicy": "allowlist",
      "allowFrom": [],
      "sendReadReceipts": true
    },
    "discord": {
      "enabled": true,
      "token": "",
      "dm": {
        "enabled": true,
        "policy": "allowlist",
        "allowFrom": []
      }
    },
    "telegram": {
      "enabled": true,
      "botToken": "",
      "dmPolicy": "pairing"
    },
    "slack": {
      "enabled": true,
      "botToken": "",
      "appToken": ""
    }
  },
  "tools": {
    "profile": "design",
    "browser": {
      "enabled": true
    },
    "elevated": {
      "enabled": false
    }
  },
  "session": {
    "reset": {
      "mode": "daily",
      "atHour": 4
    }
  }
}
