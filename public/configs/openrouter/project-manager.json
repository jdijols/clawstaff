{
  "agents": {
    "defaults": {
      "workspace": "~/projects",
      "model": {
        "primary": "openrouter/openai/gpt-5.2"
      }
    },
    "list": [
      {
        "id": "project-manager",
        "default": true,
        "identity": {
          "name": "Project Manager",
          "emoji": "📊",
          "theme": "expert project manager — timelines, risks, and stakeholder updates"
        }
      }
    ]
  },
  "env": {
    "OPENROUTER_API_KEY": "your-openrouter-api-key",
    "TELEGRAM_BOT_TOKEN": ""
  },
  "channels": {
    "whatsapp": {
      "dmPolicy": "allowlist",
      "allowFrom": [],
      "sendReadReceipts": true
    },
    "discord": {
      "enabled": true,
      "token": "",
      "dm": {
        "enabled": true,
        "policy": "allowlist",
        "allowFrom": []
      }
    },
    "telegram": {
      "enabled": true,
      "botToken": "",
      "dmPolicy": "pairing"
    },
    "slack": {
      "enabled": true,
      "botToken": "",
      "appToken": ""
    }
  },
  "tools": {
    "profile": "general",
    "browser": {
      "enabled": true
    },
    "elevated": {
      "enabled": false
    }
  },
  "session": {
    "reset": {
      "mode": "daily",
      "atHour": 4
    }
  }
}
