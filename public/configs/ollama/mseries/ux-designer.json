{
  "agents": {
    "defaults": {
      "workspace": "~/projects",
      "model": {
        "primary": "ollama/llama3.2:3b"
      },
      "maxConcurrent": 4,
      "contextTokens": 16000,
      "subagents": {
        "maxConcurrent": 8
      }
    },
    "list": [
      {
        "id": "ux-designer",
        "default": true,
        "identity": {
          "name": "UX Designer",
          "emoji": "\ud83c\udfa8",
          "theme": "expert UX designer \u2014 wireframes, prototypes, and design systems"
        }
      }
    ]
  },
  "env": {
    "TELEGRAM_BOT_TOKEN": ""
  },
  "channels": {
    "whatsapp": {
      "dmPolicy": "allowlist",
      "allowFrom": [],
      "sendReadReceipts": true
    },
    "discord": {
      "enabled": true,
      "token": "",
      "dm": {
        "enabled": true,
        "policy": "allowlist",
        "allowFrom": []
      }
    },
    "telegram": {
      "enabled": true,
      "botToken": "",
      "dmPolicy": "pairing"
    },
    "slack": {
      "enabled": true,
      "botToken": "",
      "appToken": ""
    }
  },
  "tools": {
    "profile": "design",
    "browser": {
      "enabled": true
    },
    "elevated": {
      "enabled": false
    }
  },
  "gateway": {
    "mode": "local"
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto"
  },
  "session": {
    "reset": {
      "mode": "daily",
      "atHour": 4
    }
  }
}
