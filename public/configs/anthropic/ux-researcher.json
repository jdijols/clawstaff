{
  "agents": {
    "defaults": {
      "workspace": "~/projects",
      "model": {
        "primary": "anthropic/claude-opus-4-6"
      }
    },
    "list": [
      {
        "id": "ux-researcher",
        "default": true,
        "identity": {
          "name": "UX Researcher",
          "emoji": "🔬",
          "theme": "expert UX researcher — research plans, data analysis, and insights"
        }
      }
    ]
  },
  "env": {
    "ANTHROPIC_API_KEY": "your-anthropic-api-key",
    "TELEGRAM_BOT_TOKEN": ""
  },
  "channels": {
    "whatsapp": {
      "dmPolicy": "allowlist",
      "allowFrom": [],
      "sendReadReceipts": true
    },
    "discord": {
      "enabled": true,
      "token": "",
      "dm": {
        "enabled": true,
        "policy": "allowlist",
        "allowFrom": []
      }
    },
    "telegram": {
      "enabled": true,
      "botToken": "",
      "dmPolicy": "pairing"
    },
    "slack": {
      "enabled": true,
      "botToken": "",
      "appToken": ""
    }
  },
  "tools": {
    "profile": "research",
    "browser": {
      "enabled": true
    },
    "elevated": {
      "enabled": false
    }
  },
  "session": {
    "reset": {
      "mode": "daily",
      "atHour": 4
    }
  }
}
